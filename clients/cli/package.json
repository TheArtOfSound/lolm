  "description": "LOLM control console with fail-closed code shipping, verified local artifact delivery, session continuity, and sealed receipts.",
  "type": "module",
  "bin": {
    "lolm": "bin/lolm-delivery.mjs"
  },
  "files": [
    "bin/lolm-delivery.mjs",
    "bin/lolm.mjs",
    "lib/delivery.mjs",
    "lib/diff.mjs",
    "lib/artifacts.mjs",
    "lib/paths.mjs",
    "lib/shipped.mjs",
    "lib/receipt.mjs",
    "lib/terminal.mjs",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
