{
  "name": "lolm-cli",
  "version": "1.3.0",
  "description": "Open-source local computer-use agent with a polished terminal UI, 60+ typed tools, provider-agnostic BYOK, browser automation, durable runs, and real LOLM-NFET control.",
  "type": "module",
  "bin": {
    "lolm": "bin/lolm.mjs"
  },
  "files": [
    "bin/lolm.mjs",
    "lib/agent.mjs",
    "lib/config.mjs",
    "lib/diagnostics.mjs",
    "lib/mcp.mjs",
    "lib/nfet.mjs",
    "lib/nfet_bridge.py",
    "lib/pdf.mjs",
    "lib/plugins.mjs",
    "lib/providers.mjs",
    "lib/runtime",
    "lib/secrets.mjs",
    "lib/session.mjs",
    "lib/tools.mjs",
    "lib/tools",
    "lib/tui.mjs",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "agent",
    "ai",
    "llm",
    "coding-agent",
    "byok",
    "terminal-ui",
    "nfet",
    "local-first",
    "lolm"
  ],
  "author": "Qira LLC (Bryan Leonard & Brandyn Leonard)",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://lolm.imagineqira.com/install.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheArtOfSound/lolm.git",
    "directory": "clients/cli"
  },
  "bugs": {
    "url": "https://imagineqira.com/#contact"
  }
}
