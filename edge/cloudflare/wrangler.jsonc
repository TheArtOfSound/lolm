{
  "name": "lolm-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "MONITOR", "id": "b19b949038d04cbd895608ceacdc33d4" }
  ],
  "d1_databases": [
    { "binding": "BRAIN", "database_name": "lolm-brain", "database_id": "eacc0d29-f471-4038-aba6-d5ef2f465942" }
  ],
  "vectorize": [
    { "binding": "MEMORY_INDEX", "index_name": "lolm-memory" }
  ],
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "BRAIN", "database_name": "lolm-brain", "database_id": "eacc0d29-f471-4038-aba6-d5ef2f465942" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ORIGIN": "https://lolm.imagineqira.com",
    "LINES": "demo:Hosted product API,demo4b:Lab line (optional)"
  }
}
